#!/bin/bash
# Homebrew AutoUpdate controller for macOS (compatible with Bash 3.2).

set -u
umask 077

readonly PROGRAM="brew-watchtower"
readonly VERSION="0.10.1"
readonly BREW="/opt/homebrew/bin/brew"
readonly POLICY_ROOT="/Library/Application Support/Homebrew AutoUpdate"
readonly GROUP_DIR="$POLICY_ROOT/groups"
readonly USER_HOME="${HOME}"
readonly STATE_DIR="$USER_HOME/Library/Application Support/Homebrew AutoUpdate"
readonly LOG_DIR="$USER_HOME/Library/Logs/Homebrew AutoUpdate"
readonly CACHE_DIR="$USER_HOME/Library/Caches/Homebrew AutoUpdate"
readonly LOCK_DIR="$CACHE_DIR/update.lock"
readonly CONFIG_DIR="$USER_HOME/.config/brew-watchtower"
readonly CONFIG_FILE="$CONFIG_DIR/config"

export PATH="/opt/homebrew/bin:/usr/bin:/bin:/usr/sbin:/sbin"
export HOMEBREW_NO_ANALYTICS=1
export HOMEBREW_NO_ENV_HINTS=1
export HOMEBREW_NO_INSTALL_CLEANUP=1
export NONINTERACTIVE=1

# Resolve a local-development symlink before locating the adjacent libraries.
SCRIPT_PATH=$0
while [ -L "$SCRIPT_PATH" ]; do
  LINK_DIR=$(cd -P "$(dirname "$SCRIPT_PATH")" && pwd)
  SCRIPT_PATH=$(readlink "$SCRIPT_PATH")
  case "$SCRIPT_PATH" in /*) ;; *) SCRIPT_PATH="$LINK_DIR/$SCRIPT_PATH" ;; esac
done
SCRIPT_DIR=$(cd -P "$(dirname "$SCRIPT_PATH")" && pwd)
for module in runtime scheduler policy brewfile updates; do
  # shellcheck source=/dev/null
  source "$SCRIPT_DIR/../lib/$module.sh"
done

command=${1:-help}
[ $# -eq 0 ] || shift
case "$command" in
  groups)
    case "${1:-}" in
      '') [ $# -eq 0 ] || die "groups takes no arguments"; cmd_groups ;;
      init) [ $# -eq 1 ] || die "groups init takes no arguments"; cmd_groups_init ;;
      sync) [ $# -eq 1 ] || die "groups sync takes no arguments"; cmd_groups_sync ;;
      prune) shift; cmd_groups_prune "$@" ;;
      path) [ $# -eq 1 ] || die "groups path takes no arguments"; cmd_groups_path ;;
      *) die "groups requires: init, sync, prune, path, or no arguments" ;;
    esac
    ;;
  list) [ $# -le 1 ] || die "list takes at most one group"; cmd_list "$@" ;;
  add) cmd_add "$@" ;;
  remove) cmd_remove "$@" ;;
  check) [ $# -eq 1 ] || die "check requires GROUP"; cmd_check_or_run check "$1" ;;
  run) [ $# -eq 1 ] || die "run requires GROUP"; cmd_check_or_run run "$1" ;;
  status) [ $# -le 1 ] || die "status takes at most one group"; cmd_status "$@" ;;
  history) [ $# -le 1 ] || die "history takes optional GROUP"; cmd_history "${1:-}" ;;
  ungrouped) [ $# -eq 0 ] || die "ungrouped takes no arguments"; cmd_ungrouped ;;
  acknowledge) [ $# -le 1 ] || die "acknowledge takes optional GROUP or all"; cmd_acknowledge "${1:-all}" ;;
  drift)
    case "${1:-}" in
      '') [ $# -eq 0 ] || die "drift takes no arguments"; cmd_drift ;;
      fix)
        shift
        case "$#:${1:-}" in
          0:) cmd_drift_fix backup ;;
          1:--clobber) cmd_drift_fix clobber ;;
          *) die "drift fix takes optional --clobber" ;;
        esac
        ;;
      restore)
        shift
        [ $# -eq 1 ] || die "drift restore requires a backup filename"
        cmd_drift_restore "$1"
        ;;
      *) die "drift requires: fix [--clobber], restore BACKUP, or no arguments" ;;
    esac
    ;;
  blurb) [ $# -eq 0 ] || die "blurb takes no arguments"; cmd_blurb ;;
config)
  [ $# -eq 1 ] || die "config requires: init, show, or path"
  case "$1" in
    init) cmd_config_init ;;
    show) cmd_config_show ;;
    path) cmd_config_path ;;
    *) die "config requires: init, show, or path" ;;
  esac
  ;;
  setup) cmd_setup "$@" ;;
  schedule) cmd_schedule "$@" ;;
  __setup) cmd_setup_internal "$@" ;;
  __schedule) cmd_schedule_internal "$@" ;;
  __groups_sync) cmd_groups_sync_internal "$@" ;;
  __groups_prune) cmd_groups_prune_internal "$@" ;;
  version) echo "$PROGRAM $VERSION" ;;
  help|-h|--help) usage ;;
  *) usage >&2; die "unknown command: $command" ;;
esac
