#compdef brew-watchtower

_brew_watchtower_groups() {
  local -a groups
  groups=( "${(@f)$(brew-watchtower groups 2>/dev/null | awk '{print $1}')}" )
  _describe -t groups 'Watchtower group' groups
}

_brew_watchtower_backups() {
  local brewfile
  brewfile=$(brew-watchtower config show 2>/dev/null | awk -F= '$1 == "brewfile" { print $2; exit }')
  [ -n "$brewfile" ] || return 1
  _files -W "${brewfile:h}" -g "${brewfile:t}.backup-*"
}

_brew-watchtower() {
  local -a commands
  commands=(
    'groups:list, initialize, or synchronize declarative groups'
    'list:list group items'
    'add:add or update a group item'
    'remove:remove a group item'
    'check:check one group for updates'
    'run:upgrade eligible items in one group'
    'status:show recorded status'
    'history:show recorded update history'
    'ungrouped:list installed packages outside every group'
    'acknowledge:silence the current status fingerprint'
    'drift:check, repair, or restore the configured Brewfile'
    'blurb:print shell-start status'
    'config:inspect or create user configuration'
    'setup:install or refresh protected runtime'
    'schedule:create a daily group schedule'
    'version:print version'
    'help:show help'
  )

  if (( CURRENT == 2 )); then
    _describe -t commands command commands
    return
  fi

  case "$words[2]" in
    groups)
      case $CURRENT in
        3) _values 'groups command' init sync prune path ;;
        4) [ "$words[3]" = prune ] && _values 'option' --apply ;;
      esac
      ;;
    check|run|status|history|acknowledge) _brew_watchtower_groups ;;
    remove) (( CURRENT == 3 )) && _brew_watchtower_groups ;;
    add)
      case $CURRENT in
        3) _brew_watchtower_groups ;;
        4) _values 'package type' formula cask ;;
        6) _values 'update mode' auto interactive ;;
      esac
      ;;
    drift)
      case $CURRENT in
        3) _values 'drift command' fix restore ;;
        4)
          case "$words[3]" in
            fix) _values 'option' --clobber ;;
            restore) _brew_watchtower_backups ;;
          esac
          ;;
      esac
      ;;
    config) _values 'config command' init show path ;;
    schedule) (( CURRENT == 3 )) && _brew_watchtower_groups ;;
  esac
}

_brew-watchtower "$@"
